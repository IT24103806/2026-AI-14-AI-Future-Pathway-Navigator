# ASP.NET Core API -- production configuration.
#
# Copy to /opt/pathway-navigator/deploy/pn-api.env on the VPS and fill in. That
# copy is NOT committed; this .example file is the template.
#
# There is no appsettings.json in the repository (only appsettings.example.json),
# so every value the API needs must come from here. ASP.NET Core maps nested
# config keys to environment variables with `__`, and array items with `__0`,
# `__1`, ... -- hence Cors__AllowedOrigins__0 below.
#
# chmod 600 this file on the VPS: it holds the JWT signing key and SMTP password.

# --- Database -----------------------------------------------------------------
# Managed Postgres (Neon / Supabase / Aiven). Use the pooled/direct host and
# always SslMode=Require on a managed provider.
ConnectionStrings__DefaultConnection=Host=HOST;Port=5432;Database=pathway;Username=USER;Password=PASSWORD;SslMode=Require;TrustServerCertificate=false

# AutoMigrate is a no-op in production (Program.cs:165 gates it on Development);
# the deploy pipeline runs `dotnet ef database update` instead.
Database__AutoMigrate=false
Database__MaxRetryCount=4
Database__MaxRetryDelaySeconds=5
Database__KeepAliveEnabled=true
Database__KeepAliveSeconds=240

# --- JWT ----------------------------------------------------------------------
# REQUIRED. Program.cs throws on startup without it.
# Generate: openssl rand -base64 64 | tr -d '\n'
# Rotating this invalidates every issued token.
JwtSettings__Secret=REPLACE_WITH_64_RANDOM_BYTES
JwtSettings__Issuer=PathwayNavigator.Api
JwtSettings__Audience=PathwayNavigator.Clients
JwtSettings__ExpiryMinutes=120

# --- CORS ---------------------------------------------------------------------
# REQUIRED. In production Program.cs reads this list verbatim; the defaults in
# appsettings.example.json are localhost only, so the deployed SPA would be
# blocked on every request. Add every origin the SPA is served from, including
# the *.pages.dev preview URL. No trailing slash, no path.
Cors__AllowedOrigins__0=https://yourdomain.com
Cors__AllowedOrigins__1=https://your-project.pages.dev

# --- Python AI service --------------------------------------------------------
# Internal compose service name. Never a public URL: the browser must not reach
# this service at all.
AiServiceSettings__BaseUrl=http://ai:8000
AiServiceSettings__TimeoutSeconds=90

# --- Google Sign-In -----------------------------------------------------------
# Only Google:ClientId is actually read (AuthService.cs:111) -- the flow
# validates a browser-issued ID token, so no client secret is involved here.
# Must match VITE_GOOGLE_CLIENT_ID on Cloudflare Pages, and the Cloudflare Pages
# origin must be registered as an authorised JavaScript origin in Google Cloud
# Console. Leave empty to disable Google Sign-In.
Google__ClientId=

# --- Email (password reset) ---------------------------------------------------
# If SenderEmail or SenderPassword is blank, EmailService logs the code to stdout
# instead of sending it -- fine for a smoke test, not for production.
EmailSettings__SmtpHost=smtp.gmail.com
EmailSettings__SmtpPort=587
EmailSettings__SenderEmail=
EmailSettings__SenderPassword=
EmailSettings__SenderName=Pathway Navigator Support
EmailSettings__EnableSsl=true

# --- Host ---------------------------------------------------------------------
AllowedHosts=*
