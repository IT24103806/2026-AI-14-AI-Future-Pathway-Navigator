# Python AI microservice -- production configuration.
#
# Copy to /opt/pathway-navigator/deploy/pn-ai.env on the VPS and fill in, then
# chmod 600 it. This file holds your LLM API key.
#
# Read by ai_service/core/config.py via pydantic-settings + python-dotenv. Names
# are case-sensitive and must match exactly.

# --- LLM provider -------------------------------------------------------------
# "google" or "openai"
LLM_PROVIDER=google

GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Labour-market data (Agent 3) ---------------------------------------------
# https://developer.adzuna.com/ -- free tier. Agent 3 degrades rather than fails
# if these are empty, but the roadmap loses live market signal.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=gb

# --- CORS ---------------------------------------------------------------------
# Left at the code default on purpose. This service is called only by the .NET
# API over the internal compose network, never by a browser, so its CORS list is
# not exercised in production. If you ever expose it directly, override it here
# as a JSON array, e.g.:
# BACKEND_CORS_ORIGINS=["https://api.yourdomain.com"]
