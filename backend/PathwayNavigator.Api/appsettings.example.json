{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=YourDbName;User Id=your_user;Password=your_password;TrustServerCertificate=True;"
  },
  "JwtSettings": {
    "Secret": "YOUR_VERY_SECRET_KEY_HERE",
    "Issuer": "PathwayNavigator.Api",
    "Audience": "PathwayNavigator.Clients",
    "ExpiryMinutes": 120
  },
  "Google": {
    "ClientId": "YOUR_GOOGLE_CLIENT_ID",
    "ClientSecret": "YOUR_GOOGLE_CLIENT_SECRET"
  },
  "EmailSettings": {
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587,
    "SenderEmail": "your-email@gmail.com",
    "SenderPassword": "your-app-password",
    "SenderName": "Pathway Navigator Support",
    "EnableSsl": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}