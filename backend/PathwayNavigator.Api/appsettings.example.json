{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=PathwayNavigatorDb;Username=postgres;Password=CHANGE_ME"
  },
  "JwtSettings": {
    "Secret": "YOUR_VERY_SECRET_KEY_HERE",
    "Issuer": "PathwayNavigator.Api",
    "Audience": "PathwayNavigator.Clients",
    "ExpiryMinutes": 120
  },
  "Google": {
    "ClientId": "YOUR_GOOGLE_CLIENT_ID",
    "ClientSecret": "YOUR_GOOGLE_CLIENT_SECRET"
  },
  "EmailSettings": {
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587,
    "SenderEmail": "your-email@gmail.com",
    "SenderPassword": "your-app-password",
    "SenderName": "Pathway Navigator Support",
    "EnableSsl": true
  },
  "AiServiceSettings": {
    "BaseUrl": "http://localhost:8000",
    "TimeoutSeconds": 90
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:5173", "http://127.0.0.1:5173"]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
