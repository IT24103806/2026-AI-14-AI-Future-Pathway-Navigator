# Copy to .env.local and adjust. All values are optional.

# Base URL of the ASP.NET Core API (the ONLY service the browser talks to; the Python AI service is
# internal and is called by the API). Default: http://localhost:5081/api
# Use "/api" together with the Vite dev proxy below to avoid CORS entirely.
VITE_API_BASE_URL=http://localhost:5081/api

# Where the Vite dev server proxies "/api" when VITE_API_BASE_URL=/api
VITE_PROXY_TARGET=http://localhost:5081

# Axios timeout in ms. Agent calls (LLM + market data) can be slow. Default: 120000
# VITE_API_TIMEOUT_MS=120000

# Google Sign-In (optional – the button is hidden when empty)
# VITE_GOOGLE_CLIENT_ID=
